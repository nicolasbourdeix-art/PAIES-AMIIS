// CONFIG PANEL
// ═══════════════════════════════════════════════
function openConfig() {
  document.getElementById('cfgPwdScreen').style.display='block';
  document.getElementById('cfgContent').style.display='none';
  document.getElementById('cfgPwdInput').value='';
  document.getElementById('cfgPwdError').style.display='none';
  document.getElementById('configPanel').classList.add('open');
}
function closeConfig() { document.getElementById('configPanel').classList.remove('open'); }
function checkPwd() {
  if (document.getElementById('cfgPwdInput').value===CONFIG_PWD) {
    document.getElementById('cfgPwdScreen').style.display='none';
    document.getElementById('cfgContent').style.display='block';
    // Pré-remplir onglet cabinet
    setVal('cfgCompany', CFG.company);
    setVal('cfgInitials', CFG.initials);
    setVal('cfgFonctions', CFG.fonctions.join('\n'));
    // Afficher onglet cabinet par défaut
    cfgTab('cabinet');
  } else { document.getElementById('cfgPwdError').style.display='block'; }
}
function applyConfig() {
  // Sauvegarder le panneau structure en cours si ouvert
  saveCurrentStrPanel();
  // Code admin
  var np=document.getElementById('cfgNewPwd');
  if(np && np.value.trim()) CONFIG_PWD=np.value.trim();
  // Cabinet
  var comp=g('cfgCompany'); if(comp) CFG.company=comp;
  var ini=g('cfgInitials'); if(ini) CFG.initials=ini.toUpperCase();
  // Fonctions
  var fct=document.getElementById('cfgFonctions');
  if(fct) CFG.fonctions=lines('cfgFonctions');
  // Mise à jour UI
  updateHeader(); buildStructureRadios(); buildFonctionSelect();
  // Recharger selects si une structure est sélectionnée
  if(state.structure){ buildSalarieSelects(); buildProjetSelects(); }
  // Persistance localStorage (standalone)
  try { localStorage.setItem('AMIIS_CFG', JSON.stringify(CFG)); } catch(e){}
  // Persistance Google Apps Script
  if(typeof google!=='undefined'&&google.script) google.script.run.saveConfig(JSON.stringify(CFG));
  // Feedback visuel
  var btns=document.querySelectorAll('#cfgContent .btn-primary');
  btns.forEach(function(btn){
    var orig=btn.textContent; btn.textContent='\u2713 Enregistré !';
    setTimeout(function(){ btn.textContent=orig; },1800);
  });
}

// ═══════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════
function g(id){ var el=document.getElementById(id); return el?el.value.trim():''; }
function setVal(id,v){ var el=document.getElementById(id); if(el) el.value=v; }
function lines(id){ return document.getElementById(id).value.split('\n').map(function(s){return s.trim();}).filter(Boolean); }
function newForm() { location.reload(); }

