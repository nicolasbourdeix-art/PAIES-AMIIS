// ─── Admin panel : onglets navigation ───────────────────────────
var _cfgActiveTab = 'cabinet';
var _cfgActiveStr = null;

function cfgTab(name) {
  _cfgActiveTab = name;
  document.querySelectorAll('.cfg-nav-tab').forEach(function(t){ t.classList.remove('active'); });
  document.querySelectorAll('.cfg-tab-panel').forEach(function(p){ p.classList.remove('active'); });
  var btn = document.querySelector('.cfg-nav-tab[onclick="cfgTab(\''+name+'\')"]');
  if(btn) btn.classList.add('active');
  var panel = document.getElementById('cfgTab-'+name);
  if(panel) panel.classList.add('active');
  if(name==='structures') renderStrTabs();
}

function renderStrTabs() {
  var wrap = document.getElementById('strTabsWrap');
  var contents = document.getElementById('strContents');
  wrap.innerHTML = '';
  contents.innerHTML = '';
  if(!_cfgActiveStr || CFG.structures.indexOf(_cfgActiveStr)===-1) _cfgActiveStr = CFG.structures[0]||null;

  CFG.structures.forEach(function(str){
    // Tab
    var t = document.createElement('button');
    t.className = 'str-tab' + (str===_cfgActiveStr?' active':'');
    t.textContent = str;
    t.onclick = function(){ _cfgActiveStr=str; renderStrTabs(); };
    wrap.appendChild(t);
  });

  // Contenu de la structure active
  if(_cfgActiveStr) {
    var str = _cfgActiveStr;
    if(!CFG.structureData[str]) CFG.structureData[str]={salaries:[],projets:[]};
    var d = CFG.structureData[str];
    var c = document.createElement('div');
    c.className='str-content active';
    c.innerHTML =
      '<div class="str-header-row">'
      + '<input type="text" id="strRename" value="'+str+'" placeholder="Nom de la structure">'
      + '<button class="btn-del-str" onclick="deleteStructure(\''+str+'\')">Supprimer</button>'
      + '</div>'
      + '<div class="cfg-section">Salariés</div>'
      + '<div class="cfg-field"><label>Un salarié par ligne</label>'
      + '<textarea id="strSalaries" rows="8" placeholder="Jean DUPONT\nMarie MARTIN\n...">'+d.salaries.join('\n')+'</textarea></div>'
      + '<div class="cfg-section">Projets</div>'
      + '<div class="cfg-field"><label>Un projet par ligne</label>'
      + '<textarea id="strProjets" rows="6" placeholder="Projet A\nProjet B\n...">'+d.projets.join('\n')+'</textarea></div>';
    contents.appendChild(c);
  }
}

function addStructure() {
  var name = prompt('Nom de la nouvelle structure :');
  if(!name || !name.trim()) return;
  name = name.trim();
  if(CFG.structures.indexOf(name)>-1){ alert('Cette structure existe déjà.'); return; }
  CFG.structures.push(name);
  CFG.structureData[name]={salaries:[],projets:[]};
  _cfgActiveStr=name;
  renderStrTabs();
  buildStructureRadios();
}

function deleteStructure(str) {
  if(!confirm('Supprimer la structure "'+str+'" et toutes ses données ?')) return;
  CFG.structures = CFG.structures.filter(function(s){ return s!==str; });
  delete CFG.structureData[str];
  _cfgActiveStr = CFG.structures[0]||null;
  renderStrTabs();
  buildStructureRadios();
}

// Sauvegarder les champs en cours avant d'enregistrer
function saveCurrentStrPanel() {
  if(!_cfgActiveStr) return;
  var nameEl=document.getElementById('strRename');
  var salEl=document.getElementById('strSalaries');
  var projEl=document.getElementById('strProjets');
  if(!salEl) return; // panel pas ouvert
  var oldName=_cfgActiveStr;
  var newName=nameEl?nameEl.value.trim():oldName;
  // Données
  var sal=salEl.value.split('\n').map(function(s){return s.trim();}).filter(Boolean);
  var proj=projEl.value.split('\n').map(function(s){return s.trim();}).filter(Boolean);
  // Renommer si besoin
  if(newName && newName!==oldName && CFG.structures.indexOf(newName)===-1){
    var idx=CFG.structures.indexOf(oldName);
    CFG.structures[idx]=newName;
    CFG.structureData[newName]=CFG.structureData[oldName];
    delete CFG.structureData[oldName];
    _cfgActiveStr=newName;
  }
  CFG.structureData[_cfgActiveStr]={salaries:sal, projets:proj};
}

