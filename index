// ═══════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════
function showPage(n) {
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.getElementById('page'+n).classList.add('active');
  // Bouton aide : visible seulement à partir de la page 2
  var aideBtn = document.querySelector('.aide-btn');
  if (aideBtn) {
    if (n >= 2) aideBtn.classList.add('visible');
    else aideBtn.classList.remove('visible');
  }
  setTimeout(function(){ refreshBtn(n); }, 50);
  currentPage = n;
  var pct = Math.round((n-1)/(TOTAL_PAGES-1)*100);
  document.getElementById('progressBar').style.width = pct+'%';
  window.scrollTo({top:0, behavior:'smooth'});
}

function next(from) {
  if (!validate(from)) return;

  // Routing spécial
  if (from===2) { showPage3(); showPage(3); return; }
  if (from===3) { showPage4(); showPage(4); return; }
  if (from===4) {
    // Si Technique → pas de section service (section 11 est Artistique seulement selon la logique)
    // En réalité le form envoie tout le monde en section 11 — on garde la page 5
    showPage(5); return;
  }
  if (from===5) {
    var sOui = document.getElementById('serviceOui').checked;
    if (sOui) { showPage(6); return; }
    // Pas de service → passer directement aux dates
    showPage(7); return;
  }
  if (from===8) { buildRecap(); showPage(9); return; }

  showPage(from+1);
}

function prev(from) {
  if (from===3) { showPage(2); return; }
  if (from===4) { showPage(3); return; }
  if (from===5) { showPage(4); return; }
  if (from===6) { showPage(5); return; }
  if (from===7) {
    var sOui = document.getElementById('serviceOui').checked;
    showPage(sOui ? 6 : 5); return;
  }
  if (from===9) { showPage(8); return; }
  showPage(from-1);
}

function goTo(n){ showPage(n); }

// ═══════════════════════════════════════════════
// VALIDATION
// ═══════════════════════════════════════════════
function isPageOk(n) {
  if (n===1) {
    var email = document.getElementById('email');
    var emailOk = email && email.value.trim().indexOf('@') > 0;
    return emailOk && !!state.structure;
  }
  if (n===2) {
    var s1 = document.getElementById('salNom1');
    var o1 = document.getElementById('objetNum1');
    var dd = document.getElementById('dateDebut');
    var df = document.getElementById('dateFin');
    var fn = document.getElementById('fonctionSalarie');
    var at = document.querySelector('input[name="artTech"]:checked');
    return s1&&s1.value && o1&&o1.value && dd&&dd.value && df&&df.value && fn&&fn.value && !!at;
  }
  if (n===3) {
    if (state.artTech==='Technique') return !!document.querySelector('input[name="techIdentique"]:checked');
    if (state.artTech==='Artistique') return !!document.querySelector('input[name="cachetIdentique"]:checked');
    return false;
  }
  if (n===5) return !!document.querySelector('input[name="serviceRep"]:checked');
  return true;
}

function refreshBtn(n) {
  var btn = document.getElementById('btnNext'+n);
  if (!btn) return;
  if (isPageOk(n)) btn.classList.add('ready');
  else btn.classList.remove('ready');
}

function validate(n) {
  refreshBtn(n);
  if (!isPageOk(n)) {
    var msgs = {
      1: 'Veuillez saisir votre email et sélectionner une structure.',
      2: 'Veuillez remplir tous les champs obligatoires.',
      3: 'Veuillez répondre à la question sur les montants.',
      5: 'Veuillez indiquer s\'il y a un service de répétition.'
    };
    if (msgs[n]) { alert(msgs[n]); return false; }
  }
  return true;
}

// ═══════════════════════════════════════════════
// RECAP
// ═══════════════════════════════════════════════
function buildRecap() {
  var artTech = state.artTech;
  var techId = state.techIdentique;
  var cachetId = state.cachetIdentique;
  var sOui = document.getElementById('serviceOui').checked;
  var defrOui = document.getElementById('defrOui').checked;

  // Dates sélectionnées
  var dates = [];
  for(var i=1;i<=31;i++) { if(document.getElementById('day'+i) && document.getElementById('day'+i).checked) dates.push(i); }

  // Montants Technique différent
  var techDiffDetail = '';
  if(artTech==='Technique' && techId==='Non'){
    var parts=[];
    for(var j=1;j<=5;j++){
      var m=g('tdMontant'+j), h=g('tdHeures'+j);
      if(m) parts.push('Jour '+j+' : '+m+'\u20ac — '+h);
    }
    techDiffDetail = parts.join(' | ');
  }

  // Montants cachet différent
  var cachetDiffDetail = '';
  if(artTech==='Artistique' && cachetId==='Non'){
    var parts2=[];
    for(var k=1;k<=3;k++){
      var m2=g('cdMontant'+k), nb2=g('cdNombre'+k);
      if(m2) parts2.push('Tranche '+k+' : '+m2+'\u20ac \u00d7 '+nb2);
    }
    cachetDiffDetail = parts2.join(' | ');
  }

  // Services autres
  var autreServDetail = '';
  if(sOui && document.getElementById('autreServOui').checked){
    var parts3=[];
    for(var l=1;l<=5;l++){
      var m3=g('asMontant'+l), nb3=g('asNombre'+l);
      if(m3) parts3.push('S'+l+' : '+m3+'\u20ac \u00d7 '+nb3);
    }
    autreServDetail = parts3.join(' | ');
  }

  var defrMontant='';
  if(defrOui){
    var dm=document.querySelector('input[name="defrMontant"]:checked');
    defrMontant = dm ? (dm.value==='Autre' ? g('defrMontantAutre') : dm.value) : '';
  }

  var rows = [
    ['Structure', state.structure],
    ['Email', g('email')],
    ['Nom salari\u00e9', g('salNom1')],
    ['Projet', g('objetNum1')],
    ['P\u00e9riode', g('dateDebut')+' \u2192 '+g('dateFin')],
    ['Fonction', g('fonctionSalarie')],
    ['Cat\u00e9gorie', artTech],
    artTech==='Technique' ? ['Montants/jour', techId==='Oui' ? g('techIdenMontant')+'\u20ac — '+g('techIdenHeures') : techDiffDetail] : null,
    artTech==='Artistique' ? ['Cachets', cachetId==='Oui' ? g('cachetIdenMontant')+'\u20ac \u00d7 '+g('cachetIdenNombre') : cachetDiffDetail] : null,
    sOui ? ['Service 4h', g('serviceMontant')+'\u20ac \u00d7 '+g('serviceNombre')] : null,
    autreServDetail ? ['Autres services', autreServDetail] : null,
    ['Jours travaill\u00e9s', dates.length ? dates.join(', ') : '\u2014'],
    defrOui ? ['D\u00e9fraiements', defrMontant+' \u00d7 '+g('defrNombre')] : null,
    g('commentaire') ? ['Commentaire', g('commentaire')] : null
  ].filter(Boolean);

  var html='<table class="recap-table">';
  rows.forEach(function(r){
    html+='<tr><th>'+r[0]+'</th><td>'+r[1]+'</td></tr>';
  });
  html+='</table>';
  document.getElementById('recapContent').innerHTML = html;
}

