<script>
// ═══════════════════════════════════════════════
// CONFIG
// ═══════════════════════════════════════════════
var CONFIG_PWD = 'Admincie40!';
// CFG.structures = liste des noms de structures
// CFG.structureData[nomStructure] = { salaries:[], projets:[] }
// CFG.fonctions = liste commune à toutes les structures
var CFG = {
  company: 'AMIIS',
  initials: 'AMI',
  structures: ['TXORIA BEZALA','CEKO','LES AMULECTEURS'],
  structureData: {
    'TXORIA BEZALA': { salaries: [], projets: [] },
    'CEKO':          { salaries: [], projets: [] },
    'LES AMULECTEURS': { salaries: [], projets: [] }
  },
  fonctions: [
    'metteur en sc\u00e8ne (MET)',
    'marionnettiste (MAR)',
    'com\u00e9dien (ADR)',
    'musicien (ARMU)',
    'R\u00e9gisseur g\u00e9neral (REGE)',
    'd\u00e9corateur (DECO)',
    'production (ADMP)',
    'Assistant metteur en Sc\u00e8ne (Coll)',
    'R\u00e9gisseur lumi\u00e8re (ReLu)',
    'Echassier (Ech)',
    'Danseur (dan)'
  ]
};

// ═══════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════
var state = {
  structure: '',
  artTech: '',          // 'Artistique' | 'Technique'
  techIdentique: '',    // 'Oui' | 'Non'
  cachetIdentique: ''   // 'Oui' | 'Non'
};
var currentPage = 1;
var TOTAL_PAGES = 10;

// ═══════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════
function init() {
  updateHeader();
  buildStructureRadios();
  buildFonctionSelect();
  buildTechDiffRows();
  buildCachetDiffRows();
  buildAutreServicesRows();
  buildDateGrid();
  buildSelects();
  bindAttestCheckbox();

  var hasGAS = (typeof google !== 'undefined' && google.script);

  // Email automatique (Apps Script) ou champ libre
  if (hasGAS) {
    google.script.run
      .withSuccessHandler(function(email){
        var el = document.getElementById('email');
        if (email && email.indexOf('@') > -1) {
          el.value = email;
          el.readOnly = true;
          el.style.background = '#f3f0eb';
          el.style.color = 'var(--muted)';
          document.getElementById('emailHelp').style.display = 'block';
        } else {
          el.placeholder = 'votre@email.fr';
        }
      })
      .withFailureHandler(function(){ document.getElementById('email').placeholder = 'votre@email.fr'; })
      .getUserEmail();

    // Charger la config sauvegardée (localStorage en fallback immédiat)
    try {
      var lsSaved = localStorage.getItem('AMIIS_CFG');
      if(lsSaved){
        var ls = JSON.parse(lsSaved);
        if(ls.company)       CFG.company       = ls.company;
        if(ls.initials)      CFG.initials      = ls.initials;
        if(ls.structures)    CFG.structures    = ls.structures;
        if(ls.structureData) CFG.structureData = ls.structureData;
        if(ls.fonctions)     CFG.fonctions     = ls.fonctions;
        CFG.structures.forEach(function(str){
          if(!CFG.structureData[str]) CFG.structureData[str]={salaries:[],projets:[]};
        });
        updateHeader(); buildStructureRadios(); buildFonctionSelect();
      }
    } catch(e){}
    // Puis charger depuis Google Apps Script (source de vérité partagée)
    google.script.run
      .withSuccessHandler(function(json){
        if (!json) return;
        try {
          var s = JSON.parse(json);
          if(s.company)       CFG.company       = s.company;
          if(s.initials)      CFG.initials      = s.initials;
          if(s.structures)    CFG.structures    = s.structures;
          if(s.structureData) CFG.structureData = s.structureData;
          if(s.fonctions)     CFG.fonctions     = s.fonctions;
          CFG.structures.forEach(function(str){
            if(!CFG.structureData[str]) CFG.structureData[str] = {salaries:[],projets:[]};
          });
          updateHeader(); buildStructureRadios(); buildFonctionSelect();
          // Mettre à jour localStorage avec la version GAS
          try{ localStorage.setItem('AMIIS_CFG', JSON.stringify(CFG)); }catch(e){}
        } catch(e){}
      })
      .loadConfig();
  } else {
    document.getElementById('email').placeholder = 'votre@email.fr';
    // Charger config depuis localStorage si disponible
    try {
      var saved = localStorage.getItem('AMIIS_CFG');
      if (saved) {
        var s = JSON.parse(saved);
        if(s.company)       CFG.company       = s.company;
        if(s.initials)      CFG.initials      = s.initials;
        if(s.structures)    CFG.structures    = s.structures;
        if(s.structureData) CFG.structureData = s.structureData;
        if(s.fonctions)     CFG.fonctions     = s.fonctions;
        // S'assurer que chaque structure a une entrée
        CFG.structures.forEach(function(str){
          if(!CFG.structureData[str]) CFG.structureData[str]={salaries:[],projets:[]};
        });
        updateHeader(); buildStructureRadios(); buildFonctionSelect();
      }
    } catch(e){}
  }
}

function updateHeader() {
  document.getElementById('headerInitials').textContent = CFG.initials || CFG.company.substring(0,3).toUpperCase();
