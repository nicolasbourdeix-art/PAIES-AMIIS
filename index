<script>
// Supprime la boite blanche GAS sur mobile
(function(){
  if(window.innerWidth > 700) return; // desktop: ne rien faire
  var S = 'width:100%!important;max-width:none!important;margin:0!important;padding:0!important;';
  function fix(){
    if(!document.body) return;
    document.documentElement.style.cssText += S;
    document.body.style.cssText += S;
    // Cibler le wrapper GAS (div direct du body avant notre contenu)
    var ch = document.body.children;
    for(var i=0;i<ch.length;i++){
      var el=ch[i];
      // GAS injecte un div sans classe avant notre contenu
      el.style.setProperty('width','100%','important');
      el.style.setProperty('max-width','none','important');
      el.style.setProperty('margin','0','important');
      el.style.setProperty('padding','0','important');
    }
  }
  // Plusieurs passes pour attraper l'injection GAS
  fix();
  document.addEventListener('DOMContentLoaded',fix);
  window.addEventListener('load',fix);
  [0,50,150,300,600,1200].forEach(function(t){setTimeout(fix,t);});
  // Observer les mutations DOM (GAS injecte après le chargement)
  if(window.MutationObserver){
    new MutationObserver(fix).observe(document.documentElement,{childList:true,subtree:true});
  }
})();
</script>

