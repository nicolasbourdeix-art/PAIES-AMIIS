function openAide() {
  document.getElementById('aideForm').style.display = 'block';
  document.getElementById('aideSuccess').style.display = 'none';
  // Pré-remplir l'email si disponible
  var emailField = document.getElementById('aideEmail');
  if (emailField && !emailField.value) {
    var mainEmail = g('email');
    if (mainEmail) emailField.value = mainEmail;
  }
  document.getElementById('aideOverlay').classList.add('open');
}
function closeAide() {
  document.getElementById('aideOverlay').classList.remove('open');
  // Reset formulaire
  setTimeout(function(){
    document.getElementById('aideNom').value = '';
    document.getElementById('aideEmail').value = '';
    document.getElementById('aideMessage').value = '';
    document.getElementById('aideSuccess').style.display = 'none';
    document.getElementById('aideForm').style.display = 'block';
  }, 300);
}
function closeAideOnBg(e) {
  if (e.target === document.getElementById('aideOverlay')) closeAide();
}
function envoyerAide() {
  var email   = document.getElementById('aideEmail').value.trim();
  var message = document.getElementById('aideMessage').value.trim();
  if (!email || email.indexOf('@') < 1) {
    alert('Veuillez saisir votre email.');
    return;
  }
  if (!message) {
    alert('Veuillez d\'abord décrire votre question.');
    return;
  }
  var nom  = document.getElementById('aideNom').value.trim() || 'Non renseigné';
  var btn  = document.getElementById('aideSubmitBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Envoi en cours…';

  var payload = {
    nom:       nom,
    email:     email,
    message:   message,
    structure: state.structure || 'Non précisée',
    date:      new Date().toLocaleDateString('fr-FR') + ' ' + new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'})
  };

  function done() {
    document.getElementById('aideForm').style.display = 'none';
    document.getElementById('aideSuccess').style.display = 'block';
    btn.disabled = false;
    btn.textContent = '✉ Envoyer ma question';
  }

  if (typeof google !== 'undefined' && google.script) {
    google.script.run
      .withSuccessHandler(done)
      .withFailureHandler(function(e) {
        btn.disabled = false;
        btn.textContent = '✉ Envoyer ma question';
        alert('Erreur lors de l\'envoi : ' + (e.message || e));
      })
      .envoyerDemandeAide(JSON.stringify(payload));
  } else {
    setTimeout(done, 800);
  }
}
