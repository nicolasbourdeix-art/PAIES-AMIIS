// ═══════════════════════════════════════════════
// SUBMIT
// ═══════════════════════════════════════════════
function submitForm() {
  if (!document.getElementById('attestation').checked) {
    alert('Veuillez cocher la confirmation.');
    return;
  }
  var ref = 'CTR-'+new Date().getFullYear()+'-'+String(Date.now()).slice(-5);

  var dates = [];
  for(var i=1;i<=31;i++){ if(document.getElementById('day'+i) && document.getElementById('day'+i).checked) dates.push(i); }

  // ── Collecter les détails montants ─────────────────────────
  var montantDetail = '';
  if (state.artTech === 'Technique') {
    if (state.techIdentique === 'Oui') {
      montantDetail = 'Identique : ' + g('techIdenMontant') + '€ — ' + g('techIdenHeures');
    } else {
      var parts = [];
      for (var d=1; d<=5; d++) {
        var m = g('tdMontant'+d), h = g('tdHeures'+d);
        if (m) parts.push('J'+d+' : '+m+'€ ('+h+')');
      }
      montantDetail = parts.join(' | ');
    }
  } else if (state.artTech === 'Artistique') {
    if (state.cachetIdentique === 'Oui') {
      montantDetail = 'Cachet : ' + g('cachetIdenMontant') + '€ × ' + g('cachetIdenNombre');
    } else {
      var parts2 = [];
      for (var t=1; t<=3; t++) {
        var m2 = g('cdMontant'+t), n2 = g('cdNombre'+t);
        if (m2) parts2.push('T'+t+' : '+m2+'€ × '+n2);
      }
      montantDetail = parts2.join(' | ');
    }
  }

  // ── Collecter les services ───────────────────────────────
  var serviceDetail = '';
  if (document.getElementById('serviceOui') && document.getElementById('serviceOui').checked) {
    var sp = [g('serviceMontant') + '€ × ' + g('serviceNombre') + ' service(s) 4h'];
    if (document.getElementById('autreServOui') && document.getElementById('autreServOui').checked) {
      for (var s=1; s<=5; s++) {
        var ms = g('asMontant'+s), ns = g('asNombre'+s);
        if (ms) sp.push('S'+s+' : '+ms+'€ × '+ns);
      }
    }
    serviceDetail = sp.filter(Boolean).join(' | ');
  }

  // ── Défraiements ────────────────────────────────────────
  var defrDetail = '';
  if (document.getElementById('defrOui') && document.getElementById('defrOui').checked) {
    var dm = document.querySelector('input[name="defrMontant"]:checked');
    var dmVal = dm ? (dm.value === 'Autre' ? g('defrMontantAutre') : dm.value) : '';
    defrDetail = dmVal + ' × ' + g('defrNombre');
  }

  var now = new Date();
  var payload = {
    reference:      ref,
    dateSoumission: now.toLocaleDateString('fr-FR') + ' ' + now.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}),
    email:          g('email'),
    structure:      state.structure,
    salarie:        g('salNom1'),
    projet:         g('objetNum1'),
    dateDebut:      g('dateDebut'),
    dateFin:        g('dateFin'),
    fonction:       g('fonctionSalarie'),
    artTech:        state.artTech,
    montantDetail:  montantDetail,
    serviceDetail:  serviceDetail,
    defraiement:    defrDetail,
    joursTravailes: dates.join(', '),
    commentaire:    g('commentaire')
  };

  var btn=document.getElementById('btnSubmit');
  btn.textContent='\u23f3 Envoi\u2026'; btn.disabled=true;

  function done(){
    document.getElementById('confirmRef').textContent='R\u00e9f\u00e9rence : '+ref;
    document.getElementById('confirmTable').innerHTML=
      '<tr><th>Structure</th><td>'+payload.structure+'</td></tr>'+
      '<tr><th>Salari\u00e9</th><td>'+payload.salarie+'</td></tr>'+
      '<tr><th>Fonction</th><td>'+payload.fonction+'</td></tr>'+
      '<tr><th>Cat\u00e9gorie</th><td><span class="badge badge-blue">'+payload.artTech+'</span></td></tr>'+
      '<tr><th>P\u00e9riode</th><td>'+payload.dateDebut+' \u2192 '+payload.dateFin+'</td></tr>'+
      '<tr><th>Jours</th><td>'+dates.join(', ')+'</td></tr>'+
      '<tr><th>Statut</th><td><span class="badge badge-green">Transmis AMIIS</span></td></tr>';
    showPage(10);
  }

  if (typeof google !== 'undefined' && google.script) {
    google.script.run
      .withSuccessHandler(done)
      .withFailureHandler(function(e){ btn.textContent='\u2713 Envoyer'; btn.disabled=false; alert('Erreur : '+(e.message||e)); })
      .saveNouveauContrat(JSON.stringify(payload), '[]', '[]');
  } else { setTimeout(done, 600); }
}

