// ─────────────────────────────────────────────────────────────
// RECEPTION CONTRAT  <- fonction principale
// ─────────────────────────────────────────────────────────────
function saveNouveauContrat(metaJson, lignesJson, imagesJson) {

  // 1. Parser le JSON
  var meta;
  try {
    meta = JSON.parse(metaJson || '{}');
  } catch(e) {
    Logger.log('ERREUR parse JSON : ' + e.message);
    return { status: 'error', message: 'JSON invalide : ' + e.message };
  }

  Logger.log('>>> saveNouveauContrat : ' + meta.reference + ' / ' + meta.structure);

  // 2. SHEET EN PRIORITE ABSOLUE
  var pdfUrl = '';
  try {
    var ss    = obtenirSheet();
    var sheet = ss.getSheetByName('Contrats');
    if (!sheet) sheet = ss.insertSheet('Contrats');
    creerEntetes(sheet);

    var ds = meta.dateSoumission ||
      Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm');

    sheet.appendRow([
      meta.reference      || '',
      ds,
      meta.email          || '',
      meta.structure      || '',
      meta.salarie        || '',
      meta.projet         || '',
      meta.dateDebut      || '',
      meta.dateFin        || '',
      meta.fonction       || '',
      meta.artTech        || '',
      meta.montantDetail  || '',
      meta.serviceDetail  || '',
      meta.joursTravailes || '',
      meta.defraiement    || '',
      meta.commentaire    || '',
      '...'
    ]);

    var ligneNum = sheet.getLastRow();
    Logger.log('Ligne ' + ligneNum + ' ecrite dans le Sheet');

    // 3. PDF (optionnel)
    try {
      pdfUrl = genererPDF(meta);
      Logger.log('PDF genere : ' + pdfUrl);
      sheet.getRange(ligneNum, 16).setValue(pdfUrl);
    } catch(pdfErr) {
      Logger.log('PDF non genere (non bloquant) : ' + pdfErr.message);
      sheet.getRange(ligneNum, 16).setValue('—');
    }

    // 4. Email (optionnel)
    try {
      envoyerEmail(meta, pdfUrl);
      Logger.log('Email envoye');
    } catch(mailErr) {
      Logger.log('Email non envoye (non bloquant) : ' + mailErr.message);
    }

    Logger.log('>>> saveNouveauContrat TERMINE OK');
    return { status: 'ok', url: pdfUrl };

  } catch(e) {
    Logger.log('ERREUR FATALE : ' + e.message + '\n' + e.stack);
    return { status: 'error', message: e.message };
  }
}

// ─────────────────────────────────────────────────────────────
// SHEET
// ─────────────────────────────────────────────────────────────
function obtenirSheet() {
  if (SPREADSHEET_ID) {
    Logger.log('Sheet depuis SPREADSHEET_ID');
    return SpreadsheetApp.openById(SPREADSHEET_ID);
  }
  var props   = PropertiesService.getScriptProperties();
  var savedId = props.getProperty('AUTO_SS_ID');
  if (savedId) {
    try {
      var ss = SpreadsheetApp.openById(savedId);
      Logger.log('Sheet depuis Properties : ' + ss.getUrl());
      return ss;
    } catch(e) {
      Logger.log('Sheet Properties inaccessible, recréation');
    }
  }
  var nouveau = SpreadsheetApp.create('AMIIS - Contrats V2026');
  props.setProperty('AUTO_SS_ID', nouveau.getId());
  Logger.log('Nouveau Sheet : ' + nouveau.getUrl());
  Logger.log('Copiez cet ID dans SPREADSHEET_ID : ' + nouveau.getId());
  return nouveau;
}

function creerEntetes(sheet) {
  if (sheet.getLastRow() > 0) return;
  var cols = [
    'Reference', 'Date soumission', 'Email', 'Structure',
    'Salarie', 'Projet', 'Date debut', 'Date fin',
    'Fonction', 'Art/Tech', 'Detail montants',
    'Services', 'Jours travailles', 'Defraiement', 'Commentaire',
    'Lien PDF'
  ];
  sheet.appendRow(cols);
  sheet.getRange(1, 1, 1, cols.length)
    .setFontWeight('bold')
    .setBackground('#F7941D')
    .setFontColor('white');
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 140);
  sheet.setColumnWidth(2, 130);
  sheet.setColumnWidth(4, 150);
  sheet.setColumnWidth(5, 150);
  sheet.setColumnWidth(6, 150);
}

// ─────────────────────────────────────────────────────────────
// PDF
// ─────────────────────────────────────────────────────────────
function genererPDF(meta) {
  var html = construireHtmlPDF(meta);
  var tmp  = DriveApp.createFile('_tmp_' + meta.reference + '.html', html, MimeType.HTML);
  var blob = tmp.getAs(MimeType.PDF);
  blob.setName('Contrat_' + (meta.reference || 'SANS_REF') + '_' +
               (meta.salarie || '').replace(/\s+/g, '_') + '.pdf');
  tmp.setTrashed(true);

  var parent     = FOLDER_ID ? DriveApp.getFolderById(FOLDER_ID) : DriveApp.getRootFolder();
  var sousFolder = obtenirOuCreerDossier(parent, meta.structure || 'Divers');
  var pdf        = sousFolder.createFile(blob);
  pdf.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return pdf.getUrl();
}

function obtenirOuCreerDossier(parent, nom) {
  var iter = parent.getFoldersByName(nom);
  return iter.hasNext() ? iter.next() : parent.createFolder(nom);
}

function construireHtmlPDF(meta) {
  var lignes = [
    ['Structure',        meta.structure],
    ['Email',            meta.email],
    ['Salarie',          meta.salarie],
    ['Projet',           meta.projet],
    ['Date debut',       meta.dateDebut],
    ['Date fin',         meta.dateFin],
    ['Fonction',         meta.fonction],
    ['Categorie',        meta.artTech],
    ['Montants',         meta.montantDetail],
    ['Services',         meta.serviceDetail],
    ['Jours travailles', meta.joursTravailes],
    ['Defraiements',     meta.defraiement],
    ['Commentaire',      meta.commentaire]
  ];
  var rows = lignes.map(function(r, i) {
    return '<tr style="background:' + (i%2===0?'#f9f7f4':'#fff') + '">'
      + '<td style="padding:7px 10px;color:#58595B;font-weight:600;width:35%">' + r[0] + '</td>'
      + '<td style="padding:7px 10px">' + (r[1] || '-') + '</td></tr>';
  }).join('');

  return '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>'
    + 'body{font-family:Arial,sans-serif;font-size:10.5pt;color:#333;margin:1.8cm}'
    + 'h1{color:#F7941D;font-size:15pt;margin:0 0 4px}'
    + '.ref{color:#8a8a8c;font-size:8.5pt;margin-bottom:18px}'
    + 'table{width:100%;border-collapse:collapse;border:1px solid #e0ddd8}'
    + 'td{border-bottom:1px solid #e8e4df}'
    + '.foot{color:#bbb;font-size:7.5pt;margin-top:28px;padding-top:8px;border-top:1px solid #eee}'
    + '</style></head><body>'
    + '<h1>Nouveau Contrat AMIIS V2026</h1>'
    + '<p class="ref">Ref. <strong>' + (meta.reference || '') + '</strong>'
    + ' | ' + (meta.dateSoumission || '') + '</p>'
    + '<table>' + rows + '</table>'
    + '<p class="foot">Document genere automatiquement - AMIIS</p>'
    + '</body></html>';
}

// ─────────────────────────────────────────────────────────────
// EMAIL
// ─────────────────────────────────────────────────────────────
function envoyerEmail(meta, pdfUrl) {
  var cabinetEmail = EMAIL_CABINET ||
    PropertiesService.getScriptProperties().getProperty('EMAIL_CABINET') || '';
  var to = meta.email || '';
  var cc = (cabinetEmail && cabinetEmail !== to) ? cabinetEmail : '';
  if (!to && !cc) { Logger.log('Pas d email defini'); return; }

  var sujet = '[AMIIS] Contrat ' + (meta.reference || '') +
              ' - ' + (meta.salarie || '') + ' / ' + (meta.structure || '');

  var rows = [
    ['Reference',  meta.reference],
    ['Structure',  meta.structure],
    ['Salarie',    meta.salarie],
    ['Projet',     meta.projet],
    ['Fonction',   meta.fonction],
    ['Categorie',  meta.artTech],
    ['Periode',    (meta.dateDebut || '') + ' -> ' + (meta.dateFin || '')],
    ['Jours',      meta.joursTravailes],
    ['Montants',   meta.montantDetail]
  ].map(function(r, i) {
    return '<tr style="background:' + (i%2===0?'#fff':'#f5f3ef') + '">'
      + '<td style="padding:6px 8px;color:#8a8a8c;width:38%;font-weight:600">' + r[0] + '</td>'
      + '<td style="padding:6px 8px">' + (r[1] || '-') + '</td></tr>';
  }).join('');

  var corps =
    '<div style="font-family:Arial,sans-serif;max-width:580px">'
    + '<div style="background:#F7941D;padding:14px 20px;border-radius:8px 8px 0 0">'
    + '<h2 style="color:white;margin:0;font-size:14pt">Nouveau Contrat AMIIS</h2></div>'
    + '<div style="background:#F9F7F4;padding:20px;border:1px solid #E8E4DF;border-radius:0 0 8px 8px">'
    + '<table style="width:100%;border-collapse:collapse;font-size:9.5pt">' + rows + '</table>'
    + (pdfUrl ? '<p style="margin-top:18px"><a href="' + pdfUrl
      + '" style="background:#58595B;color:white;padding:9px 18px;border-radius:6px;text-decoration:none">Voir le PDF</a></p>' : '')
    + '<p style="color:#aaa;font-size:7.5pt;margin-top:20px">AMIIS</p>'
    + '</div></div>';

  var opts = { to: to || cc, subject: sujet, htmlBody: corps };
  if (to && cc) opts.cc = cc;
  MailApp.sendEmail(opts);
}

